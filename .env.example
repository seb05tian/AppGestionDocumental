# Solo para desarrollo local. Genera una clave y credenciales distintas para cada servidor.
DJANGO_SECRET_KEY=cambia-esta-clave-local-por-una-larga-y-aleatoria
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000
APP_PORT=8000
# En producción, usa el origen HTTPS del portal para los enlaces de vinculación.
APP_PUBLIC_URL=

POSTGRES_DB=asistente
POSTGRES_USER=asistente
POSTGRES_PASSWORD=asistente_dev

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Admisiones <no-reply@example.invalid>
# Para SMTP: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0

MAX_UPLOAD_MB=10
MAX_UPLOADS_PER_HOUR=30
OCR_MAX_PAGES=20
AI_PREVALIDATION_ENABLED=0
OCR_DPI=150
OCR_MAX_IMAGE_PIXELS=12000000
OCR_TIMEOUT_SECONDS=60
OCR_MAX_ATTEMPTS=3
OCR_STALE_MINUTES=15
OCR_RULES_VERSION=2026-01
# Reglas de tipo separadas por |; versiona OCR_RULES_VERSION al cambiarlas.
# OCR_IDENTITY_KEYWORDS=cedula|documento de identidad|tarjeta de identidad|passport|pasaporte
# OCR_SABER11_KEYWORDS=saber 11|icfes|resultado de pruebas
# OCR_GRADUATION_KEYWORDS=acta de grado|acta de graduacion
# OCR_DIPLOMA_KEYWORDS=diploma|titulo de bachiller
LOGIN_RATE_LIMIT=5
# Límite por dirección IP: evita probar muchas cuentas desde una misma fuente.
LOGIN_IP_RATE_LIMIT=20
EMAIL_MAX_ATTEMPTS=5
EMAIL_STALE_MINUTES=5
